# ==============================================================================
# DPDP Vault — Local Fallback Worker Configuration
# ==============================================================================
# This configuration allows your local PC to run as a fallback worker
# connecting to the same production queue as https://dpdp-gilt.vercel.app
# and processing Playwright browser inspection jobs when Railway is offline.
#
# Instructions:
# 1. Copy this file to .env.worker:
#    Copy-Item .env.worker.example .env.worker
# 2. Fill in the values from your production environment or .env.local
# 3. Never commit .env.worker to Git!
# ==============================================================================

# MongoDB Connection String (must point to production MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ek18u.mongodb.net/dpdp_assessment?retryWrites=true&w=majority

# Google Gemini API Key (for AI-powered statutory DPDP evaluation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Cloudinary Cloud Storage for Evidence Screenshots
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Secret & Encryption Key
JWT_SECRET=your_jwt_secret_key_here

# Worker Process Tuning (optional)
# POLL_INTERVAL_MS=3000
# RECONCILE_INTERVAL_MS=60000
