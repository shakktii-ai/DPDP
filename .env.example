# =======================================================
# DPDP Automated Website Assessment Platform Configuration
# =======================================================

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/dpdp_assessment

# Google Gemini API Key (Server-side only, NEVER expose via NEXT_PUBLIC)
GEMINI_API_KEY=your_gemini_api_key_here

# Proposed initial Gemini Model for DPDP Assessment & Vision Analysis
# Note: Verified dynamically at runtime to ensure availability before execution
GEMINI_MODEL=gemini-3.8-flash

# JWT Secret for Session Authentication & Token Signing
JWT_SECRET=dpdp-assessment-platform-secure-jwt-secret-key-2026

# Application Settings
NEXT_PUBLIC_APP_NAME="DPDP Automated Assessment Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary Cloud Storage for Evidence Screenshots
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
